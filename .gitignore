# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
private

# Virtual environments
.venv/
env/
venv/
ENV/

# Temporary files & logs
*.log
*.tmp
compile.log
tests/__pycache__/
