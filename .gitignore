# Local SQLite databases (keep schema, exclude local trading logs)
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Runtime ephemeral files & kill flags
config/ai/KILL
config/ai/heartbeat.json

# Operating system artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
