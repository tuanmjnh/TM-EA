; TM-EA / TM_SessionBreakout - H1 BASELINE for CENT (USC) account, small capital
; Same logic as H1 BASELINE. Use on a CENT account so 0.01 lot of gold fits risk ~1%.
; Example: 50 USD = 5,000 USC deposit; risk 1% = 50 USC per trade.
; RESEARCH CANDIDATE - not confirmed for live. Forward-demo first.

Enabled=true
MagicNumber=555101
TradeComment=TM_SB_CENT
Entry_TF=16385

;--- Session 1 range / window (server hours)
RangeStartHour=0
RangeEndHour=7
TradeStartHour=7
TradeEndHour=20

;--- Session 2 disabled
Use_Session2=false

;--- Entry / exit
Use_ADX_Filter=true
ADX_Period=14
ADX_Min=20.0
Min_Range_ATR=0.0
Max_Range_ATR=100.0
RR=5.0
SL_Range_Fraction=1.0
OneTradePerDay=true

;--- Risk / execution
RiskPercentPerTrade=1.0
Min_Volume=0.01
Max_Volume=0.50
Max_Spread_Points=350
