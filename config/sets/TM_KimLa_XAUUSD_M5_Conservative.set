; ==============================================================================
; KIM LA EA - Conservative Low-Risk Preset (Capital Preservation Priority)
; Symbol: XAUUSD / XAUUSDm
; Timeframe: M5
; Lower risk (0.25%), Max 1 trade per session, TP 2.0x, Circuit Breaker 1.5%
; ==============================================================================

InpEnabled=true
InpMagicNumber=20261114
InpTradeComment=KIM_LA_CONSERV

; --- Indicator Settings
InpPoints_ATR=14
InpEMA_D1_Period=200
InpEMA_H1_Period=50
InpEMA_M5_Period=20
InpADX_Period=14
InpADX_EntryMin=25.0
