; --- Multi-Timeframe Alignment
InpStrictD1Alignment=true

; --- Risk & Lot Sizing
InpLotMode=0
InpRiskPct=0.25
InpMinLot=0.01
InpMaxLot=0.05
InpAllowMinLotFallback=true

; --- Circuit Breakers & Loss Guard
InpMaxDailyLossPct=1.5
InpMaxConsecLosses=2
InpCooldownAfterLossMin=60

; --- Stop Loss & Take Profit
InpATR_EntryStop=1.8
InpUseTakeProfit=true
InpTP_ATR_Mult=2.0
InpATR_BreakevenBuffer=0.8
InpTrailStart=2.0
InpTrailStep1=1.6
InpTrailStep2=1.2
InpTrailStep3=0.9

; --- Session Times (GMT)
InpServerGMTOffset=0
InpLondonStart_Hour=8
InpLondonStart_Min=0
InpLondonEnd_Hour=17
InpNYStart_Hour=13
InpNYStart_Min=30
InpNYEnd_Hour=21
InpMaxTradesPerSession=1
InpCloseOnSessionEnd=true

; --- Execution & Protection
InpExecType=0
InpMaxSpreadPoints=300
InpMaxSeconds_EntryFill=60
InpPullbackSwingBars=4
InpCooldownReconnectSec=0
