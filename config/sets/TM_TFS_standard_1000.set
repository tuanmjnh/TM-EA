; TM-EA - Standard Account Preset (1,000 USD)
; Target: XAUUSDm on M5 (Exness point = 0.001).
; Risk: 0.5% ($5.00 cash risk per trade) allowing 0.01 - 0.05 lot positions.
; Pullback-only entry; Take Profit enabled; equity circuit breaker at 10%.

Enabled=true
MagicNumber=123456
TradeComment=TM_TFS_1000

;--- Trend Filter (M15)
Trend_Timeframe=15
FastEMA_HTF=50
SlowEMA_HTF=200
ADX_Period=14
ADX_Threshold=25.0

;--- Entry (M5 Pullback only)
Entry_Timeframe=5
PullbackEMA=20
Pullback_Buffer_pips=2

;--- Exit / Trailing (TP enabled)
Use_TP=true
TP_ATR_Mult=1.5
Trail_ATR_Mult=2.0
Trail_ATR_Period=14
Activate_After_Profit_pips=4.0
Trail_Step_pips=2.0
Breakeven_After_pips=8.0

;--- Risk Management
RiskPercentPerTrade=0.5
Min_Volume=0.01
Max_Volume=0.05
Max_Concurrent_Positions=1

;--- Risk Guards (REALISTIC COSTS ACTIVE)
Max_Equity_DD_Percent=10.0
Max_Daily_Loss_Percent=1.5
Max_Consecutive_Losses=4
CoolDown_Minutes=45
Max_Spread_Points=350
News_Enable=true
News_Buffer_Minutes=20
Use_Session_Filter=true
