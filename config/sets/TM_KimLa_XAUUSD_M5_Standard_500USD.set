InpTrailStep3=1.0

; --- Session Times (GMT)
InpServerGMTOffset=0
InpLondonStart_Hour=8
InpLondonStart_Min=0
InpLondonEnd_Hour=17
InpNYStart_Hour=13
InpNYStart_Min=30
InpNYEnd_Hour=21
