; ==============================================================================
; KIM LA EA - Standard USD Account Preset ($500 USD)
; Symbol: XAUUSD / XAUUSDm
; Timeframe: M5
; LOT_MODE_STANDARD (1) for standard currency accounts
; ==============================================================================

InpEnabled=true
InpMagicNumber=20261115
InpTradeComment=KIM_LA_500USD

; --- Indicator Settings
InpPoints_ATR=14
InpEMA_D1_Period=200
InpEMA_H1_Period=50
InpEMA_M5_Period=20
