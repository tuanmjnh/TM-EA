{
  "default_provider": "tokenharbor",
  "providers": {
    "tokenharbor": {
      "enabled": true,
      "base_url": "https://tokenharbor.ai/v1",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        "claude-sonnet-4.6",
        "deepseek-v4.1-flash",
        "deepseek-v4-pro",
        "gemini-3.8-flash",
        "gpt-6-astra-fast"
      ],
      "rate_limit_rpm": 120,
      "cost_per_1m_input": 0.50,
      "cost_per_1m_output": 1.50
    }
  }
}
